# Commart Platform — Environment Variables
# Copy this to .env and fill in your values

# Database
DB_PASSWORD=commart123

# GitHub Container Registry
GHCR_ORG=prasannakrishna
GITHUB_ORG=prasannakrishna

# Cashfree Payment Gateway (optional — for payment processing)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# WhatsApp Meta Cloud API (optional — for notifications)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# AWS (optional — for S3, SNS/SQS notifications)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
